{
  "name": "@magp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Magp 全新后端(Midway v4 单进程):业务(app/cms)+ agent(common/agent),模块+接口+DI 解耦。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app",
    "build": "mwtsc --cleanOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "start": "cross-env NODE_ENV=production node ./bootstrap.js"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "4.2.1",
    "@midwayjs/core": "4.2.1",
    "@midwayjs/koa": "4.2.1",
    "@midwayjs/logger": "4.0.1",
    "@midwayjs/validate": "4.2.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.70.0",
    "ws": "8.21.1",
    "zod": "^4.0.0",
    "@midwayjs/ws": "4.2.1"
  },
  "devDependencies": {
    "@midwayjs/mock": "4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^16.0.0",
    "mwtsc": "^1.9.0",
    "prisma": "^6.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
